# Copy to ./config/compose.prd.env and pass it with:
#   docker compose --env-file ./config/compose.prd.env \
#     -f docker-compose.prd.yaml ...

COMPOSE_PROJECT_NAME=ai-gateway-prd

# Immutable application release to deploy.
AI_GATEWAY_IMAGE=ghcr.io/oai404iao/ai_gateway
AI_GATEWAY_VERSION=0.3.1
AI_GATEWAY_PULL_POLICY=missing

# Host-local listener defaults. Put the Console listener behind HTTPS before
# exposing it to browsers or the Internet.
AI_GATEWAY_BIND_ADDRESS=127.0.0.1
AI_GATEWAY_PORT=3000
AI_GATEWAY_CONSOLE_BIND_ADDRESS=127.0.0.1
AI_GATEWAY_CONSOLE_PORT=3001

# File locations remain outside the image and are ignored by Git.
AI_GATEWAY_CONFIG_FILE=./config/config.prd.toml
AI_GATEWAY_POSTGRES_PASSWORD_FILE=./config/postgres-password
AI_GATEWAY_CONSOLE_JWT_PRIVATE_FILE=./config/console-jwt-private.pem
AI_GATEWAY_CONSOLE_JWT_PUBLIC_FILE=./config/console-jwt-public.pem

# PostgreSQL defaults match deploy/compose/config.example.toml. If either
# value changes, update the [database].url in config.prd.toml too.
AI_GATEWAY_POSTGRES_DB=ai_gateway
AI_GATEWAY_POSTGRES_USER=ai_gateway
