# Local test-only settings. Copy this file to .env.real-upstream; never commit
# the copied file or a real upstream credential.
#
# REAL_UPSTREAM_BASE_URL is the channel base URL. The gateway appends
# /v1/chat/completions or /v1/responses, so do not include that final endpoint.
REAL_UPSTREAM_BASE_URL="https://api.example.invalid"
REAL_UPSTREAM_API_KEY="replace-with-a-dedicated-low-budget-test-key"

# Both endpoint formats are smoke-tested. The Responses upstream/model must
# also support Responses WebSocket mode and be recognized by the installed
# Codex CLI. These models may be different.
REAL_UPSTREAM_CHAT_COMPLETIONS_MODEL="replace-with-a-chat-completions-model"
REAL_UPSTREAM_RESPONSES_MODEL="replace-with-a-responses-model"

# Optional Codex CLI command or absolute path used by the Responses WebSocket
# smoke. Defaults to `codex`.
REAL_UPSTREAM_CODEX_BIN="codex"

# Must be at least 3. Defaults to 60 when omitted.
REAL_UPSTREAM_TIMEOUT_SECONDS="60"
