# Local test-only settings. Copy this file to .env.real-upstream; never commit
# the copied file or a real upstream credential.
#
# REAL_UPSTREAM_BASE_URL is the default channel base URL for Chat Completions
# and Responses HTTP/SSE. The gateway appends the selected /v1/... route, so
# do not include the final endpoint.
REAL_UPSTREAM_BASE_URL="https://api.example.invalid"
REAL_UPSTREAM_API_KEY="replace-with-a-dedicated-low-budget-test-key"

# Both endpoint formats are smoke-tested. The Responses upstream/model must
# also support Responses WebSocket mode. These models may be different.
REAL_UPSTREAM_CHAT_COMPLETIONS_MODEL="replace-with-a-chat-completions-model"
REAL_UPSTREAM_RESPONSES_MODEL="replace-with-a-responses-model"

# Optional Responses behavior profile. Keep the default for ordinary
# OpenAI-compatible upstreams. Use codex_oauth when the configured URL/key
# targets an ai-gateway instance whose Responses route selects a Codex OAuth
# managed channel. In that mode SSE uses a Codex-compatible request shape and
# the non-streaming test expects codex_streaming_required.
# REAL_UPSTREAM_RESPONSES_PROFILE="codex_oauth"

# Optional paired override for Responses WebSocket. When omitted, WebSocket
# uses REAL_UPSTREAM_BASE_URL, REAL_UPSTREAM_API_KEY, and the Responses model.
# REAL_UPSTREAM_WEBSOCKET_BASE_URL="https://websocket.example.invalid"
# REAL_UPSTREAM_WEBSOCKET_API_KEY="replace-with-a-dedicated-websocket-test-key"

# Optional Images generation/edit smoke. Set all three values to enable the
# two paid Images tests; otherwise both tests are skipped. The gateway appends
# /v1/images/generations or /v1/images/edits to this channel base URL.
# REAL_UPSTREAM_IMAGES_BASE_URL="https://images.example.invalid"
# REAL_UPSTREAM_IMAGES_API_KEY="replace-with-a-dedicated-images-test-key"
# REAL_UPSTREAM_IMAGES_MODEL="replace-with-a-low-budget-images-model"

# Must be at least 3. Defaults to 60 when omitted.
REAL_UPSTREAM_TIMEOUT_SECONDS="60"
